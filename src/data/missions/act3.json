      { "type": "spawnPed", "tag": "guards", "x": -238, "z": -152, "yaw": -1.57, "app": "cop", "state": "patrol", "weapon": "pistol" },
      { "type": "spawnPed", "tag": "guards", "x": -265, "z": -158, "yaw": 3.14, "app": "cop", "state": "guard", "weapon": "pistol" },
      { "type": "stealth", "x": -262, "z": -150, "radius": 2.5, "text": "Sneak to the <b>evidence room door</b>", "guards": "guards", "detect": 12 },
