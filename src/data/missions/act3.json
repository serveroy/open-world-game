      { "type": "choice", "text": "What does Nico do?", "options": [
        { "label": "📜 Hand the ledger to the feds", "flag": "ending", "value": "A" },
        { "label": "🔫 Kill Price, take the coast", "flag": "ending", "value": "B" }
      ] },
      { "type": "despawn", "tag": "price" },
      { "type": "despawn", "tag": "lena" },
      { "type": "despawn", "tag": "theo" },
      { "type": "branch", "flag": "ending", "value": "A", "mission": "m22a_cleangetaway" },
      { "type": "branch", "flag": "ending", "value": "B", "mission": "m22b_kingofthecoast" }
    ]
  },
