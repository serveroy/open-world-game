        { "who": "Theo", "text": "There's a federal boat off the point. Juno called them. Hand it over and Price is done — legally.", "dur": 5 },
        { "who": "Price", "text": "Or kill me and take the coast. Dima's finished, the docks are empty. Somebody has to run Port Solano.", "dur": 5 },
        { "who": "Lena", "text": "Nico… don't become them.", "dur": 2.6 }
