      { "type": "pedAction", "tag": "lt", "action": "hostile" },
      { "type": "destroy", "tag": "lt", "text": "Sink the <b>Marlin</b>" },
      { "type": "dialogue", "lines": [{ "who": "Theo", "text": "(radio) Dima just lost a year of profit. He'll come after Sal. He always goes for the old ones.", "dur": 4.4 }] }
    ]
  },
  {
    "id": "m19_salslastride",
    "act": 3,
    "title": "Sal's Last Ride",
    "giver": "sal",
    "start": { "x": 1180, "z": 362, "radius": 3.5 },
    "requires": ["m18_breakwater"],
    "reward": 14000,
    "hour": 18,
    "summary": "Dima's crew rolls into Dustwater to make an example of Sal. Hold the town.",
    "steps": [
      { "type": "spawnPed", "tag": "sal", "x": 1184, "z": 362, "yaw": 3.14, "app": "story:sal", "state": "talk", "health": 900 },
      { "type": "dialogue", "lines": [
        { "who": "Sal", "text": "Trucks on the Mesa Loop, coming in hot. Dima wants a show.", "dur": 3.6 },
        { "who": "Sal", "text": "The old Longshot's in my truck. You remember how I taught you to breathe?", "dur": 3.8 },
        { "who": "Nico", "text": "In, out, squeeze.", "dur": 1.8 }
      ] },
      { "type": "give", "weapon": "sniper", "ammo": 30 },
      { "type": "armor", "amount": 100 },
      { "type": "pedAction", "tag": "sal", "action": "cower" },
      { "type": "help", "text": "Hold <b>◎</b> to look down the scope. Aim assist is reduced for snipers — line up headshots.", "time": 7 },
      { "type": "checkpoint", "x": 1180, "z": 350 },
      { "type": "survive", "time": 90, "text": "Hold <b>Dustwater</b>", "waves": [
        { "at": 0, "tag": "raid", "count": 4, "x": 1300, "z": 300, "r": 10, "app": "thug", "weapon": "smg", "vehicle": "mule" },
        { "at": 20, "tag": "raid", "count": 4, "x": 1230, "z": 440, "r": 10, "app": "thug", "weapon": "rifle", "vehicle": "ranger" },
        { "at": 45, "tag": "raid", "count": 5, "x": 1080, "z": 420, "r": 10, "app": "thug", "weapon": "shotgun" },
        { "at": 65, "tag": "raid", "count": 4, "x": 1300, "z": 330, "r": 10, "app": "biker", "weapon": "smg", "vehicle": "thunder" }
      ] },
      { "type": "kill", "tag": "raid", "text": "Finish off the <b>raiders</b>" },
      { "type": "dialogue", "lines": [
        { "who": "Sal", "text": "Took one in the shoulder. I'll live — I'm too ornery to die in my own town.", "dur": 4 },
        { "who": "Sal", "text": "Price keeps a villa on Pelican Isle. That's where he'll run. End it, Nico.", "dur": 4 }
      ] }
    ],
    "fail": [{ "type": "dead", "tag": "sal", "text": "Sal was killed" }]
  },
  {
