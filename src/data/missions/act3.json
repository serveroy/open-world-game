[
  {
    "id": "m16_oldfriends",
    "act": 3,
    "title": "Old Friends",
    "giver": "theo",
    "start": { "x": 1113, "z": 355, "radius": 3.5 },
    "requires": ["m15_brotherskeeper"],
    "reward": 8000,
    "hour": 11,
    "weather": "clear",
    "summary": "Theo finally agrees to talk — at the Dusty Spoon diner in Dustwater.",
    "steps": [
      { "type": "spawnPed", "tag": "theo", "x": 1117, "z": 357, "yaw": -1.57, "app": "story:theo", "state": "sit", "health": 800 },
      { "type": "cutscene", "shots": [{ "orbit": "theo", "dist": 3.4, "height": 1.5, "angle": 0.9, "dur": 22, "fov": 40 }], "lines": [
        { "who": "Theo", "text": "I know what you want to do to me. Hear me out first.", "dur": 3.4 },
        { "who": "Theo", "text": "Westbank was never a robbery. Price needed the vault empty before the auditors came.", "dur": 4.4 },
        { "who": "Theo", "text": "He paid me to make sure the driver got caught. Dima fronted the money. I took it, and I ran.", "dur": 5 },
        { "who": "Nico", "text": "Five years, Theo.", "dur": 2 },
        { "who": "Theo", "text": "I know. The key you found — box 214. Price's ledger is in there. Every payment. Every name.", "dur": 5 },
        { "who": "Theo", "text": "And Dima's people followed you here.", "dur": 2.6 }
      ] },
      { "type": "spawnGroup", "tag": "volk", "count": 6, "x": 1180, "z": 300, "r": 14, "app": "thug", "weapon": "smg", "hostile": true, "health": 90 },
      { "type": "kill", "tag": "volk", "text": "Take out <b>Dima's crew</b>" },
      { "type": "dialogue", "lines": [
        { "who": "Theo", "text": "I'll get you inside the bank. Price moved the box to the evidence room at HQ last week. Of course he did.", "dur": 5 }
      ] },
      { "type": "unlock", "what": "contact", "id": "theo" }
    ],
    "fail": [{ "type": "dead", "tag": "theo", "text": "Theo was killed" }]
  },
  {
